# Copy to .env for local sync runs (`bun run sync:hourly`). .env is ignored by
# git: never commit real values. In production these are GitHub Actions
# secrets (the sync) and Cloudflare Pages variables (the dashboard); README.md
# says which goes where.

# ---- Central database (sync and dashboard) ----
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# ---- Dashboard only (Cloudflare Pages; `bun run local` writes test values to .dev.vars) ----
# DASHBOARD_USERNAME=                       from `bun run set-login`
# DASHBOARD_PASSWORD=pbkdf2-sha256$...      from `bun run set-login`
# SESSION_SECRET=                           from `bun run hash-password --secret`
# REVENUECAT_WEBHOOK_AUTH=                  optional, 16 characters or more

# ---- RevenueCat: one v2 secret key a game (charts_metrics read) ----
PEARL_TIDE_REVENUECAT_API_KEY=
CHILLWATER_REVENUECAT_API_KEY=
# <PREFIX>_REVENUECAT_PROJECT_ID=           optional: the key's first project is used

# ---- PostHog: one personal API key (query:read) scoped to every game's project, one project a game ----
POSTHOG_PERSONAL_API_KEY=
PEARL_TIDE_POSTHOG_PROJECT_ID=767644
CHILLWATER_POSTHOG_PROJECT_ID=768046
# <PREFIX>_POSTHOG_PERSONAL_API_KEY=        optional: a game whose project is in another PostHog account
POSTHOG_HOST=https://us.posthog.com
# <PREFIX>_POSTHOG_HOST=                    optional: a game on the EU cloud

# ---- App Store Connect: one team key for every game ----
ASC_KEY_ID=
ASC_ISSUER_ID=
# The .p8 file's text. In .env, one line with \n between the lines.
ASC_PRIVATE_KEY=
ASC_VENDOR_NUMBER=

# ---- Google Play: one service account for every game ----
# The key file's JSON on one line.
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
# pubsite_prod_... from Play Console, Download reports, Statistics.
GOOGLE_PLAY_BUCKET=

# ---- Each game's own database: a read-only Postgres connection string ----
PEARL_TIDE_GAME_DB_URL=
CHILLWATER_GAME_DB_URL=
